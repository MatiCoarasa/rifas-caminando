{
  "compilerOptions": {
    "target": "ES2022", // ES2022 is a good choice as it's the latest version
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true, // It's recommended to enable strict mode for better type safety
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext", // ESNext for module system
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve", // Updated for React 17+ JSX transform
    "incremental": true,
    "baseUrl": ".", // Recommended for better module resolution
    "paths": {
      "@/*": [
        "src/*"
      ] // Custom path mappings if required
    },
    "skipDefaultLibCheck": true, // Optional but recommended for performance
    "useDefineForClassFields": true, // Ensures `class` fields are defined per the spec
    "downlevelIteration": true, // Ensures better iteration support
    "composite": true // For incremental builds and projects with multiple TS files
    ,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src",
    "next-env.d.ts",
    "./build/types/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
