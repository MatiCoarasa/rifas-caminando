# Precio unitario de cada rifa (usado en el front y al crear la preferencia de pago)
NEXT_PUBLIC_PRECIO_RIFA=

# URL base de la app, usada para armar las back_urls de Mercado Pago (success/failure)
APP_URL=

# Credenciales de Mercado Pago
MP_ACCESS_TOKEN=
# Secret key para validar la firma de los webhooks de Mercado Pago
HOOKS_SECRET=

# Credenciales de la cuenta de Gmail usada para enviar mails (nodemailer)
EMAIL=
EMAIL_PWD=

# Conexión a MongoDB
DB_CONN_STRING=
DB_NAME=
DB_COLL_RIFAS=
DB_COLL_COUNTER=
# _id del documento contador en la colección DB_COLL_COUNTER
COUNTER_ID=
